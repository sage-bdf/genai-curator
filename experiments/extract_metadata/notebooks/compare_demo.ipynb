# Metadata Comparison Demo

This notebook demonstrates how to use the CSVComparator module to compare metadata files from two different folders.
## Setup and Configuration
import sys

# Import the client library
sys.path.append('../src')

from csv_comparator import CSVComparator

# Define paths to the original and generated metadata folders
original_metadata_folder = "../data/ground_truth"
generated_metadata_folder = "../data/predicted"
## Initialize the CSVComparator

We'll create an instance of the CSVComparator class and load the files from both folders.
# Initialize the comparator with the paths to the folders
comparator = CSVComparator(
    generated_folder=generated_metadata_folder,
    original_folder=original_metadata_folder,
    generated_key_column="name",  # Column in generated files to use for matching
    original_key_column="name"        # Column in original files to use for matching
)

# Load all files from both folders
comparator.load_files()
# Get values for organ column in file with ID 2
file_id = "3"
column = "organ"

# Get side-by-side comparison
organ_comparison = comparator.get_side_by_side_comparison(file_id, column)
organ_comparison
